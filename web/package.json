{
  "name": "hart-web-site",
  "private": true,
  "version": "0.1.0",
  "description": "Browser demo for hart, a from-scratch RV64GC RISC-V emulator",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/hart-web --release --target web --out-dir ../../web/src/wasm --out-name hart_web --no-pack",
    "wasm:stub": "wasm-pack build ../crates/hart-web --release --target web --out-dir ../../web/src/wasm --out-name hart_web --no-pack -- --features stub",
    "images": "node scripts/prepare-images.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
